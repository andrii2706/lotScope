# Шаблон змінних для продакшну у Vercel. Заповніть значення і вставте весь текст
# у Vercel → Settings → Environment Variables (поле приймає вміст .env файлу), середовище Production.
# Реальні значення в цей файл не записуйте і не комітьте.

DATABASE_URL=postgresql://postgres.[ref]:[пароль]@aws-0-[регіон].pooler.supabase.com:6543/postgres
APP_URL=https://назва-проєкту.vercel.app
ADMIN_EMAILS=admin@ваш-домен
ANTHROPIC_API_KEY=
SESSION_HOURS=8
SALES_CONTACT=sales@ваш-домен

AUCTION_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
MAIL_FROM=LotScope <noreply@send.ваш-домен>
MAIL_REPLY_TO=support@ваш-домен

DATABASE_SSL_CA=
