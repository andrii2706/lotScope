# Ключ Claude API: https://platform.claude.com/ → API keys.
# Без нього застосунок працює в демо-режимі (звіт показує приклад, а не аналіз фото).
ANTHROPIC_API_KEY=

# Необов'язково. Модель для аналізу фото.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Необов'язково. Глибина міркувань моделі: low, medium, high, xhigh або max.
# ANTHROPIC_EFFORT=high

# Необов'язково. Ключ ліцензованого постачальника даних аукціонів (apiauctions.io).
# Вмикає «Знайти лот»: автозаповнення за посиланням, номером лота чи VIN, фото та ціни продажів схожих лотів.
# Без ключа «Знайти лот» показує лише посилання на Copart, IAAI, Carfax та AutoCheck.
# AUCTION_API_KEY=
# AUCTION_API_URL=https://apiauctions.io

# Необов'язково. VinAudit (офіційні дані NMVTIS: титули, статуси Salvage/Junk, страхові записи, пробіг).
# Разом з AUCTION_API_KEY дає автоматичну історію за VIN. Кожен запит платний (близько $1).
# VINAUDIT_API_KEY=
# VINAUDIT_USER=
# VINAUDIT_PASS=

# Обов'язково. База даних Postgres (локально: docker compose up -d, потім npm run db:migrate).
DATABASE_URL=postgres://lotscope:lotscope@localhost:5432/lotscope

# Публічна адреса застосунку. На неї LiqPay надсилає підтвердження оплати, а Google повертає користувача після входу.
APP_URL=http://localhost:3000

# Email супер адмінів через кому. Зареєструйтеся з такою поштою, і акаунт стане супер адміном (консоль /admin).
ADMIN_EMAILS=

# Тривалість сесії в годинах (за замовчуванням 8).
# SESSION_HOURS=8

# Контакт для компаній, що хочуть підключитися (показується на сторінці реєстрації).
# SALES_CONTACT=sales@example.com

# Оплата карткою через LiqPay (кабінет liqpay.ua → Магазин → Налаштування API).
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# Необов'язково. 1 вмикає тестовий режим LiqPay (статус sandbox вважається успішним).
# LIQPAY_SANDBOX=1
# Необов'язково. sha1 (за замовчуванням) або sha3-256: алгоритм підпису запитів до LiqPay.
# Підписи від LiqPay перевіряються за обома алгоритмами.
# LIQPAY_SIGNATURE=sha1

# Вхід через Google (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, тип Web application).
# У Authorized redirect URIs додайте: APP_URL + /api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Реквізити для оплати за рахунком (рядки розділяйте \n).
# INVOICE_DETAILS=ФОП Прізвище Ім'я\nIBAN: UA...\nЄДРПОУ: ...
