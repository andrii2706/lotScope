# Ключ Claude API: https://platform.claude.com/ → API keys.
# Без нього застосунок працює в демо-режимі (звіт показує приклад, а не аналіз фото).
ANTHROPIC_API_KEY=

# Необов'язково. Модель для аналізу фото.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Необов'язково. Глибина міркувань моделі: low, medium, high, xhigh або max.
# ANTHROPIC_EFFORT=high

# Необов'язково. Ключ ліцензованого постачальника даних аукціонів (apiauctions.io).
# Вмикає «Знайти лот»: автозаповнення за посиланням, номером лота чи VIN, фото та ціни продажів схожих лотів.
# Без ключа «Знайти лот» показує лише посилання на Copart, IAAI, Carfax та AutoCheck.
# AUCTION_API_KEY=
# AUCTION_API_URL=https://apiauctions.io

# Необов'язково. VinAudit (офіційні дані NMVTIS: титули, статуси Salvage/Junk, страхові записи, пробіг).
# Разом з AUCTION_API_KEY дає автоматичну історію за VIN. Кожен запит платний (близько $1).
# VINAUDIT_API_KEY=
# VINAUDIT_USER=
# VINAUDIT_PASS=

# AUTO.RIA (developers.ria.com): ринкова ціна авто в Україні, безкоштовний ключ ~1000 запитів/міс, 30/год
# AUTORIA_API_KEY=

# Окрема модель для пошуку цін запчастин на Allegro/OLX (за замовчуванням ANTHROPIC_MODEL)
# ANTHROPIC_PARTS_MODEL=

# Обов'язково. База даних Postgres (локально: docker compose up -d, потім npm run db:migrate).
DATABASE_URL=postgres://lotscope:lotscope@localhost:5432/lotscope

# Для хмарних баз (Supabase, Neon, Vercel Postgres) SSL вмикається автоматично без перевірки ланцюжка сертифікатів.
# DATABASE_SSL=

# Необов'язково. CA-сертифікат бази (Supabase → Database → Settings → SSL Configuration) для повної перевірки з'єднання.
# Вставте вміст файлу; переноси рядків можна записати як \n.
# DATABASE_SSL_CA=off вимикає SSL, verify вмикає повну перевірку сертифіката.
# DATABASE_SSL=

# Публічна адреса застосунку: з неї будуються посилання в листах і адреса повернення після входу через Google.
APP_URL=http://localhost:3000

# Email супер адмінів через кому. Створіть акаунт: npm run user:password -- you@example.com (або увійдіть через Google з цією поштою).
ADMIN_EMAILS=

# Тривалість сесії в годинах (за замовчуванням 8).
# SESSION_HOURS=8

# Контакт відділу продажів для компаній, що хочуть отримати доступ (показується на сторінці входу).
# SALES_CONTACT=sales@example.com

# Вхід через Google (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, тип Web application).
# У Authorized redirect URIs додайте: APP_URL + /api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Листи «Забули пароль?» через Resend (resend.com). MAIL_FROM — адреса з підтвердженого в Resend домену.
# Без цих змінних лист не надсилається; у режимі розробки посилання виводиться в консоль сервера.
# RESEND_API_KEY=
# MAIL_FROM=LotScope <noreply@ваш-домен.ua>
# Необов'язково. Куди підуть відповіді на лист (спільна скринька підтримки, не особиста пошта).
# MAIL_REPLY_TO=support@ваш-домен.ua
